# Database (MongoDB Atlas). Without it the site falls back to data/*.json files.
# IMPORTANT: the database name must be part of the URI (…mongodb.net/rouillard-sport).
# A URI without a path silently resolves to the `test` database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/rouillard-sport
# Optional: overrides the database name when the URI has no path.
MONGODB_DB=rouillard-sport

# Auth — JWT session secret + bootstrap admin credentials.
# With MONGODB_URI set, the Admin collection wins once a record exists.
AUTH_SECRET=generate-a-long-random-string
ADMIN_EMAIL=admin@rouillard-sport.com
ADMIN_PASSWORD=change-me

# Public origin (canonical URLs, OG, JSON-LD, sitemap)
SITE_URL=https://www.rouillard-sport.com
NEXT_PUBLIC_SITE_URL=https://www.rouillard-sport.com

# Cloudinary — env wins; can also be saved in Admin > Settings without a redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Gmail app password). SMTP_SECURE=false for port 587 STARTTLS,
# true only for port 465 (implicit TLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
# All outbound mail is sent from (and admin notices go to) this sender only.
EMAIL_FROM=Rouillard Sport <your-address@gmail.com>
NOTIFICATION_EMAIL=your-address@gmail.com
